  "item": [
    {
      "name": "01. Public Endpoints",
      "item": [
        {
          "name": "Health Check (Public - No Token Required)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "Reward Catalog (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rewards/catalog",
              "host": ["{{baseUrl}}"],
              "path": ["rewards", "catalog"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02. Registration & Identity",
      "item": [
        {
          "name": "Register User Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Eleanor Vance\",\n  \"phone\": \"+919876543210\",\n  \"preferredLanguage\": \"en\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register/user",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register", "user"]
            }
          },
          "response": []
        },
        {
          "name": "Register Vendor Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{unverifiedVendorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Master Rajesh Sharma\",\n  \"phone\": \"+919888877770\",\n  \"preferredLanguage\": \"en\",\n  \"businessName\": \"Bangalore Precision Electronics Atelier\",\n  \"businessType\": \"Certified Repair Workshop\",\n  \"address\": \"42 Heritage Avenue\",\n  \"city\": \"Bengaluru\",\n  \"state\": \"Karnataka\",\n  \"pincode\": \"560001\",\n  \"serviceTypes\": [\"REPAIR\", \"RECYCLING\"],\n  \"deviceCategories\": [\"SMARTPHONE\", \"LAPTOP\"],\n  \"documentUrl\": \"https://example.com/certs/license.pdf\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register/vendor",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register", "vendor"]
            }
          },
          "response": []
        },
        {
          "name": "Get Authenticated Identity Profile (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          },
          "response": []
        }
      ]
    },
